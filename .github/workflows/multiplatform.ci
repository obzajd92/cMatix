name: Multi-Cloud Production Monitoring, LaTeX Compilation & Automated Release Delivery

on:
  push:
    branches: [ "main", "develop" ]
    tags: [ "v*" ] # Explicitly trigger execution on release tag generation sequences
  pull_request:
    branches: [ "main" ]

permissions:
  contents: write
  packages: write

jobs:
  profile-compile-and-release:
    name: Telemetry Loops, Report Compiling & Release Asset Ingestion
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Repository Code
      uses: actions/checkout@v4

    - name: Set up Go Runtime Environment
      uses: actions/go-version@v5
      with:
        go-version: '1.21'

    - name: Install System Dependencies & LaTeX Core Compiler
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential gcc make texlive-latex-base texlive-fonts-recommended

    - name: Build Local Core Computation Images
      uses: docker/build-push-action@v6
      with:
        context: .
        file: ./Dockerfile
        push: false
        tags: cloud-benchmark:latest
        load: true
        cache-from: type=gha,scope=cloud-bench-cache

    - name: Run Compute Telemetry Sweeps
      run: |
        docker run --rm --cpuset-cpus="0" cloud-benchmark:latest --benchmark -O3 > ec2_run.log
        docker run --rm -m 128m cloud-benchmark:latest --benchmark -O3 > lambda_run.log
        
        EC2_TIME=$(grep "BENCHMARK_TIME" ec2_run.log | cut -d'|' -f3 || echo "0.08")
        LAMBDA_TIME=$(grep "BENCHMARK_TIME" lambda_run.log | cut -d'|' -f3 || echo "0.12")
        
        echo "EC2_RUN_TIME=$EC2_TIME" >> $GITHUB_ENV
        echo "LAMBDA_RUN_TIME=$LAMBDA_TIME" >> $GITHUB_ENV

    # =================================================================
    # LATEX AUTOMATED COMPILATION STEP
    # =================================================================
     Silbermatic Document Generation Pass
    - name: Compile Academic Findings Document to PDF
      run: |
        pdflatex -interaction=batchmode findings.tex
        pdflatex -interaction=batchmode findings.tex

    # =================================================================
    # GO WEBHOOK MONITORING & ALERT DISPATCH SYSTEM
    # =================================================================
    - name: Compile and Fire Go Statistical Alert Hook
      env:
        ONCALL_WEBHOOK_URL: ${{ secrets.ONCALL_WEBHOOK_URL }}
        TELEMETRY_DB_CONN: ${{ secrets.TELEMETRY_DB_CONN }}
      run: |
        go get ://github.com
        go build -o alert_hook hook.go
        ./alert_hook --lambda-time="${{ env.LAMBDA_RUN_TIME }}"

    # =================================================================
    # AUTOMATED GITHUB RELEASES ASSET INGESTION STEP
    # =================================================================
    - name: Attach and Publish Compiled LaTeX PDF onto Active Release Tag
      if: startsWith(github.ref, 'refs/tags/v') # Executes exclusively during tagging sequences
      uses: softprops/action-gh-release@v2
      with:
        files: findings.pdf
        body: |
          ### 📊 Automated Performance & Structural Validation Trends Report
          This release contains the verified production-ready build artifacts along with the automatically compiled system verification and analysis report.
          
          - **Tag Reference**: `${{ github.ref_name }}`
          - **Commit Signature**: `${{ github.sha }}`
        fail_on_unsupported_partial_releas: false
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
